(require :asdf)
(push (uiop:pathname-directory-pathname *load-truename*) asdf:*central-registry*)
(asdf:load-asd (merge-pathnames "type-i.asd" *load-truename*))
(asdf:load-system :type-i)
(multiple-value-bind (type known) (type-i:test-type '(typep type-i:? 'integer))
  (assert known) (assert (eq type 'integer)))
(multiple-value-bind (type known) (type-i:test-type '(integerp type-i:?))
  (assert known) (assert (subtypep type 'integer)))
(assert (member '(typep type-i:? 'integer) (type-i:type-tests 'integer) :test #'equal))
(let* ((test '(typep type-i:? 'integer))
       (output (with-output-to-string (*standard-output*)
                 (multiple-value-bind (type known) (type-i:test-type test t)
                   (assert known)
                   (assert (eq type 'integer))))))
  (assert (string= output (format nil " test: ~a inferred type: ~a" test 'integer))))
(format t "TYPE-I-EGCL-PASS~%")
